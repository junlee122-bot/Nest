# 둥지(Nest) 환경 변수
# 이 파일을 복사해 .env.local 로 만들고 실제 키를 넣으세요.
# .env.local 은 .gitignore 에 의해 커밋되지 않습니다.

# Anthropic Claude API 키 (서버에서만 사용, 클라이언트에 노출 금지)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# (선택) 사용할 모델 ID. 미설정 시 claude-opus-4-8 사용.
# ANTHROPIC_MODEL=claude-opus-4-8

# (선택) 텍스트 전용 요청(사진 없는 수리·행정·공과금·계약서·장보기) 라우팅용 모델.
# 미설정 시 ANTHROPIC_MODEL 과 동일. 비용·속도 최적화가 필요하면 예: claude-sonnet-5
# ANTHROPIC_MODEL_TEXT=claude-sonnet-5

# ── 공공데이터 연동 (v3 P5) — 전부 선택. 미설정이어도 모든 기능이 폴백으로 동작 ──

# 법제처 국가법령정보 공동활용 (계약서 체커의 법령 근거를 '현행 원문'으로 승격)
# 발급: https://open.law.go.kr → 신청 후 OC(기관코드 = 가입 이메일 ID) 사용
# LAW_API_OC=your_email_id

# 공공데이터포털(data.go.kr) 범용 서비스 키 — 아래 4개 API에 공용
#  · 국토교통부 전월세 실거래가(아파트/오피스텔/단독다가구) → /rent 시세
#  · 기상청 단기예보(초단기실황) → 수리 진단의 날씨 맥락
#  · 한국천문연구원 특일 정보(공휴일) → 연락 타이밍 맥락
#  · 국토교통부 건축HUB 건축물대장 → /rent 건물 정보(준공·용도)
# 발급: data.go.kr 가입 → 각 API '활용신청' → 일반 인증키(Decoding)
# DATA_GO_KR_SERVICE_KEY=...

# 카카오 REST API 키 (수리 결과의 '주변 업체 미리보기')
# 발급: https://developers.kakao.com → 앱 생성 → REST API 키
# KAKAO_REST_API_KEY=...

# aT KAMIS 농축수산물 일일 소매가 (장보기 코치의 '오늘 시세' 접지)
# 미설정 시 내장 참고가격표로 폴백. 발급: https://www.kamis.or.kr → Open-API 인증키 신청
# 개발 확인용으로 test/test 가 동작하지만(실측) 운영에선 반드시 정식 키를 쓰세요.
# 주의: 서버가 느려 첫 요청은 폴백되고, 백그라운드 캐시 후 다음 요청부터 시세가 붙습니다.
# KAMIS_CERT_KEY=...
# KAMIS_CERT_ID=...      # 신청 시 등록한 회원 ID

# Pexels 음식 참고 이미지 (장보기 '남은 재료' AI 레시피 카드 사진)
# 미설정 시 텍스트 카드로 폴백. 발급: https://www.pexels.com/api/ (무료)
# PEXELS_API_KEY=...

# 식약처 식품안전나라 오픈API (장보기 '공공 레시피로 더 해먹기')
# 미설정 시 해당 섹션 생략. 발급: https://www.foodsafetykorea.go.kr → 오픈API 인증키(COOKRCP01)
# FOODSAFETY_API_KEY=...

# ── 주거비 자동분석 베타 (금융결제원 오픈뱅킹 테스트베드) ──
# 미설정 시 /money 페이지는 "베타 준비중" 안내로 안전하게 표시됩니다(앱 정상 동작).
# 값은 developers.kftc.or.kr / developers.openbanking.or.kr 의 현재 가이드에서 확인하세요.
# OPENBANKING_CLIENT_ID=...
# OPENBANKING_CLIENT_SECRET=...
# OPENBANKING_REDIRECT_URI=http://localhost:3000/api/openbanking/callback
# OPENBANKING_BASE_URL=https://testapi.openbanking.or.kr
# OPENBANKING_ORG_CODE=          # 이용기관코드(10자리) — 거래내역조회 bank_tran_id 생성용
# OPENBANKING_SCOPE=login inquiry
# OPENBANKING_API_VERSION=v2.0
